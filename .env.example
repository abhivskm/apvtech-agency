# ───────────────────────── Required ─────────────────────────
# Local dev uses docker-compose (port 5433). On Neon use the POOLED url here
# and the DIRECT (non-pooled) url for DIRECT_DATABASE_URL (used by migrations).
DATABASE_URL="postgresql://agency:agency_dev_password@localhost:5433/agency?schema=public"
DIRECT_DATABASE_URL="postgresql://agency:agency_dev_password@localhost:5433/agency?schema=public"

# Public base URL, no trailing slash. Used for canonical URLs, sitemap and OG tags.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Long random string (≥32 chars). Used to hash IPs / sign preview + cron requests.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET="replace-with-a-long-random-string"

# ───────────────────────── Media storage ─────────────────────────
# "local" (dev only – writes to ./storage, NOT persistent on Vercel) or "s3" (Cloudflare R2 / AWS S3)
STORAGE_DRIVER="local"
MAX_UPLOAD_MB="10"
MAX_VIDEO_UPLOAD_MB="50"
# S3 / R2 settings (only when STORAGE_DRIVER="s3")
S3_ENDPOINT=""                # R2: https://<accountid>.r2.cloudflarestorage.com
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""         # Public bucket / custom domain, e.g. https://media.example.com

# ───────────────────────── Email (Resend) ─────────────────────────
# Leave blank to disable delivery. Enquiries are always stored; the outbox shows "not configured".
RESEND_API_KEY=""
EMAIL_FROM=""                 # e.g. "Website <hello@yourdomain.com>" – domain must be verified in Resend

# ───────────────────────── Jobs ─────────────────────────
# Bearer token required by /api/cron/outbox (Vercel Cron sends it automatically as CRON_SECRET)
CRON_SECRET=""

# ───────────────────────── Tests ─────────────────────────
TEST_DATABASE_URL="postgresql://agency:agency_dev_password@localhost:5433/agency_test?schema=public"
