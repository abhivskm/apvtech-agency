generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// ─────────────────────────────── Enums ───────────────────────────────

enum Role {
  SUPER_ADMIN
  EDITOR
  MARKETING
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum MediaKind {
  IMAGE
  VIDEO
  EXTERNAL_VIDEO
}

enum NavLocation {
  HEADER
  FOOTER_SERVICES
  FOOTER_INDUSTRIES
  FOOTER_COMPANY
  FOOTER_LEGAL
}

enum EnquiryStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  CLOSED
}

enum OutboxStatus {
  PENDING
  SENT
  FAILED
  SKIPPED_UNCONFIGURED
}

// ─────────────────────────────── Auth ───────────────────────────────

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         Role      @default(EDITOR)
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions          Session[]
  activity          ActivityLog[]
  assignedEnquiries Enquiry[]      @relation("EnquiryAssignee")
  enquiryNotes      EnquiryNote[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  ipHash    String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// Generic sliding-window counter used for login throttling and form rate limiting.
model RateLimitHit {
  id        String   @id @default(cuid())
  bucket    String
  createdAt DateTime @default(now())

  @@index([bucket, createdAt])
}

// ─────────────────────────────── Media ───────────────────────────────

model MediaAsset {
  id         String    @id @default(cuid())
  kind       MediaKind @default(IMAGE)
  /// Storage key for uploaded files (null for external URLs).
  storageKey String?   @unique
  /// Public URL (served by storage adapter or external host).
  url        String
  filename   String
  mime       String?
  size       Int?
  width      Int?
  height     Int?
  alt        String    @default("")
  caption    String?
  credit     String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  settingsLogo      SiteSettings[] @relation("SettingsLogo")
  settingsFavicon   SiteSettings[] @relation("SettingsFavicon")
  settingsOgImage   SiteSettings[] @relation("SettingsOgImage")
  pagesOg           Page[]         @relation("PageOg")
  servicesHero      Service[]      @relation("ServiceHero")
  servicesOg        Service[]      @relation("ServiceOg")
  projectsCover     Project[]      @relation("ProjectCover")
  projectsOg        Project[]      @relation("ProjectOg")
  projectGallery    ProjectMedia[]
  industriesHero    Industry[]     @relation("IndustryHero")
  articlesCover     Article[]      @relation("ArticleCover")
  articlesOg        Article[]      @relation("ArticleOg")
  testimonialPhotos Testimonial[]

  @@index([kind])
  @@index([createdAt])
}

// ─────────────────────────────── Settings ───────────────────────────────

model SiteSettings {
  id                  String  @id @default("singleton")
  brandName           String
  brandShortName      String?
  tagline             String
  supportingMessage   String  @default("")
  logoId              String?
  logo                MediaAsset? @relation("SettingsLogo", fields: [logoId], references: [id], onDelete: SetNull)
  faviconId           String?
  favicon             MediaAsset? @relation("SettingsFavicon", fields: [faviconId], references: [id], onDelete: SetNull)
  ogImageId           String?
  ogImage             MediaAsset? @relation("SettingsOgImage", fields: [ogImageId], references: [id], onDelete: SetNull)
  /// { background, surface, elevated, text, muted, accent, border }
  colors              Json
  contactEmail        String?
  phone               String?
  whatsappNumber      String?
  whatsappMessage     String  @default("Hi, I found your website and would like to discuss digital services for my business.")
  address             String?
  city                String?
  region              String?
  postalCode          String?
  country             String  @default("IN")
  serviceAreas        String  @default("")
  businessHours       String?
  notificationEmail   String?
  defaultCtaLabel     String  @default("Start a Project")
  defaultCtaHref      String  @default("/contact")
  footerText          String  @default("")
  copyrightText       String  @default("")
  defaultSeoTitle     String
  defaultSeoDescription String
  titleTemplate       String  @default("%s | {brand}")
  siteUrl             String?
  gscVerification     String?
  gaMeasurementId     String?
  gtmContainerId      String?
  consentEnabled      Boolean @default(false)
  consentMessage      String  @default("We use cookies for analytics only after you agree.")
  googleBusinessUrl   String?
  enquiryRetentionDays Int    @default(730)
  /// Shown under prices on the pricing page, e.g. "+ 18% GST".
  pricingNote         String  @default("Prices exclude 18% GST.")
  updatedAt           DateTime @updatedAt
}

model SocialProfile {
  id        String   @id @default(cuid())
  platform  String
  label     String
  url       String
  order     Int      @default(0)
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

model NavItem {
  id        String      @id @default(cuid())
  location  NavLocation
  label     String
  href      String
  order     Int         @default(0)
  visible   Boolean     @default(true)
  newTab    Boolean     @default(false)
  parentId  String?
  parent    NavItem?    @relation("NavChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children  NavItem[]   @relation("NavChildren")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([location, order])
}

model Redirect {
  id        String   @id @default(cuid())
  fromPath  String   @unique
  toPath    String
  permanent Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────── Pages ───────────────────────────────

model Page {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  /// System pages (home, about, contact, legal…) are rendered by dedicated routes and cannot be deleted.
  isSystem       Boolean       @default(false)
  status         ContentStatus @default(DRAFT)
  publishedAt    DateTime?
  seoTitle       String?
  seoDescription String?
  canonicalUrl   String?
  noindex        Boolean       @default(false)
  ogImageId      String?
  ogImage        MediaAsset?   @relation("PageOg", fields: [ogImageId], references: [id], onDelete: SetNull)
  sections       PageSection[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status, publishedAt])
}

model PageSection {
  id        String   @id @default(cuid())
  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  /// Section type key – validated by zod schemas in src/lib/validation/sections.ts
  type      String
  /// Optional stable key for system sections (e.g. "home-hero")
  key       String?
  order     Int      @default(0)
  visible   Boolean  @default(true)
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([pageId, key])
  @@index([pageId, order])
}

// ─────────────────────────────── Services ───────────────────────────────

model Service {
  id               String        @id @default(cuid())
  slug             String        @unique
  title            String
  /// Homepage grouping, e.g. "Digital Experience"
  category         String        @default("")
  shortDescription String
  featuredLabel    String?
  heroHeadline     String
  heroText         String        @default("")
  heroMediaId      String?
  heroMedia        MediaAsset?   @relation("ServiceHero", fields: [heroMediaId], references: [id], onDelete: SetNull)
  body             String        @default("")
  problems         String[]      @default([])
  benefits         String[]      @default([])
  deliverables     String[]      @default([])
  /// [{ title, description }]
  process          Json          @default("[]")
  ctaLabel         String?
  ctaHref          String?
  whatsappMessage  String?
  order            Int           @default(0)
  showOnHome       Boolean       @default(true)
  status           ContentStatus @default(DRAFT)
  publishedAt      DateTime?
  seoTitle         String?
  seoDescription   String?
  canonicalUrl     String?
  noindex          Boolean       @default(false)
  ogImageId        String?
  ogImage          MediaAsset?   @relation("ServiceOg", fields: [ogImageId], references: [id], onDelete: SetNull)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  faqs        Faq[]
  relatedTo   ServiceRelation[] @relation("RelFrom")
  relatedFrom ServiceRelation[] @relation("RelTo")
  projects    ProjectService[]
  industries  IndustryService[]

  @@index([status, order])
}

model ServiceRelation {
  fromId String
  toId   String
  from   Service @relation("RelFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to     Service @relation("RelTo", fields: [toId], references: [id], onDelete: Cascade)

  @@id([fromId, toId])
}

// ─────────────────────────────── Industries ───────────────────────────────

model Industry {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  shortTitle     String        @default("")
  intro          String
  needs          String[]      @default([])
  body           String        @default("")
  heroMediaId    String?
  heroMedia      MediaAsset?   @relation("IndustryHero", fields: [heroMediaId], references: [id], onDelete: SetNull)
  order          Int           @default(0)
  status         ContentStatus @default(DRAFT)
  publishedAt    DateTime?
  seoTitle       String?
  seoDescription String?
  canonicalUrl   String?
  noindex        Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  services IndustryService[]
  projects Project[]

  @@index([status, order])
}

model IndustryService {
  industryId String
  serviceId  String
  industry   Industry @relation(fields: [industryId], references: [id], onDelete: Cascade)
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([industryId, serviceId])
}

// ─────────────────────────────── Projects ───────────────────────────────

model ProjectCategory {
  id       String @id @default(cuid())
  slug     String @unique
  name     String
  order    Int    @default(0)
  projects ProjectCategoryLink[]
}

model Project {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  client         String?
  /// Concept projects are self-initiated work, labelled publicly as such.
  isConcept      Boolean       @default(true)
  year           Int?
  summary        String
  description    String        @default("")
  challenge      String        @default("")
  solution       String        @default("")
  outcome        String        @default("")
  coverId        String?
  cover          MediaAsset?   @relation("ProjectCover", fields: [coverId], references: [id], onDelete: SetNull)
  videoUrl       String?
  industryId     String?
  industry       Industry?     @relation(fields: [industryId], references: [id], onDelete: SetNull)
  featured       Boolean       @default(false)
  order          Int           @default(0)
  status         ContentStatus @default(DRAFT)
  publishedAt    DateTime?
  seoTitle       String?
  seoDescription String?
  canonicalUrl   String?
  noindex        Boolean       @default(false)
  ogImageId      String?
  ogImage        MediaAsset?   @relation("ProjectOg", fields: [ogImageId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  gallery    ProjectMedia[]
  services   ProjectService[]
  categories ProjectCategoryLink[]
  metrics    ProjectMetric[]

  @@index([status, order])
  @@index([featured])
}

model ProjectMedia {
  id        String     @id @default(cuid())
  projectId String
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mediaId   String
  media     MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  order     Int        @default(0)

  @@index([projectId, order])
}

model ProjectService {
  projectId String
  serviceId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([projectId, serviceId])
}

model ProjectCategoryLink {
  projectId  String
  categoryId String
  project    Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category   ProjectCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([projectId, categoryId])
}

model ProjectMetric {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  label     String
  value     String
  note      String?
  /// Only verified metrics are shown publicly.
  verified  Boolean @default(false)
  order     Int     @default(0)
}

// ─────────────────────────────── Articles ───────────────────────────────

model ArticleCategory {
  id       String    @id @default(cuid())
  slug     String    @unique
  name     String
  articles Article[]
}

model Tag {
  id       String       @id @default(cuid())
  slug     String       @unique
  name     String
  articles ArticleTag[]
}

model Article {
  id             String           @id @default(cuid())
  slug           String           @unique
  title          String
  excerpt        String
  body           String           @default("")
  coverId        String?
  cover          MediaAsset?      @relation("ArticleCover", fields: [coverId], references: [id], onDelete: SetNull)
  authorName     String           @default("")
  authorRole     String?
  categoryId     String?
  category       ArticleCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  readingMinutes Int              @default(5)
  status         ContentStatus    @default(DRAFT)
  publishedAt    DateTime?
  seoTitle       String?
  seoDescription String?
  canonicalUrl   String?
  noindex        Boolean          @default(false)
  ogImageId      String?
  ogImage        MediaAsset?      @relation("ArticleOg", fields: [ogImageId], references: [id], onDelete: SetNull)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  tags ArticleTag[]

  @@index([status, publishedAt])
}

model ArticleTag {
  articleId String
  tagId     String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
}

// ─────────────────────────────── Social proof ───────────────────────────────

model Testimonial {
  id        String        @id @default(cuid())
  name      String
  role      String?
  company   String?
  quote     String
  photoId   String?
  photo     MediaAsset?   @relation(fields: [photoId], references: [id], onDelete: SetNull)
  status    ContentStatus @default(DRAFT)
  order     Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, order])
}

model Faq {
  id        String        @id @default(cuid())
  question  String
  answer    String
  group     String        @default("general")
  serviceId String?
  service   Service?      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  status    ContentStatus @default(DRAFT)
  order     Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, group, order])
  @@index([serviceId])
}

// ─────────────────────────────── Plans ───────────────────────────────

/// Client packages shown on /pricing. Prices are whole rupees, exclusive of tax; null = not applicable.
model Plan {
  id            String        @id @default(cuid())
  slug          String        @unique
  name          String
  tagline       String        @default("")
  bestFor       String        @default("")
  description   String        @default("")
  /// One-time setup / project fee (₹). Null when the plan has no setup fee.
  setupPrice    Int?
  /// Recurring monthly fee (₹). Null when the plan has no monthly fee.
  monthlyPrice  Int?
  /// Shown before the price, e.g. "Starting from". Leave both prices empty for "Custom quote".
  pricePrefix   String        @default("Starting from")
  /// Optional line such as "Everything in Growth, plus:" shown above the feature list.
  includesLabel String?
  features      String[]      @default([])
  /// Optional notes such as "Ad spend paid directly to Google/Meta".
  notes         String[]      @default([])
  highlighted   Boolean       @default(false)
  badge         String?
  ctaLabel      String        @default("Choose this plan")
  order         Int           @default(0)
  status        ContentStatus @default(DRAFT)
  publishedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status, order])
}

// ─────────────────────────────── Leads ───────────────────────────────

model Enquiry {
  id            String        @id @default(cuid())
  name          String
  businessName  String?
  email         String
  phone         String
  website       String?
  industry      String?
  services      String[]      @default([])
  budget        String?
  timeline      String?
  message       String
  consent       Boolean
  consentAt     DateTime?
  sourcePath    String?
  /// Plan selected on the pricing page / contact form (plan name at the time of enquiry).
  plan          String?
  status        EnquiryStatus @default(NEW)
  readAt        DateTime?
  assigneeId    String?
  assignee      User?         @relation("EnquiryAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  ipHash        String?
  fingerprint   String
  anonymizedAt  DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  notes  EnquiryNote[]
  emails EmailOutbox[]

  @@index([status, createdAt])
  @@index([fingerprint, createdAt])
  @@index([createdAt])
}

model EnquiryNote {
  id        String   @id @default(cuid())
  enquiryId String
  enquiry   Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body      String
  createdAt DateTime @default(now())

  @@index([enquiryId])
}

model EmailOutbox {
  id          String       @id @default(cuid())
  enquiryId   String?
  enquiry     Enquiry?     @relation(fields: [enquiryId], references: [id], onDelete: SetNull)
  toAddress   String?
  subject     String
  text        String
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  lastError   String?
  sentAt      DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status, createdAt])
}

// ─────────────────────────────── Audit ───────────────────────────────

model ActivityLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail String?
  action     String
  entityType String
  entityId   String?
  summary    String   @default("")
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([actorId])
}

/// First-party analytics. One row per anonymous visit (30-minute inactivity timeout). Never holds raw IPs, form contents or user agents.
model AnalyticsSession {
  id           String   @id
  visitorId    String
  isNewVisitor Boolean  @default(false)
  startedAt    DateTime @default(now())
  lastSeenAt   DateTime @default(now())
  entryPath    String   @default("")
  currentPath  String   @default("")
  channel      String   @default("Direct")
  source       String   @default("direct")
  referrerHost String?
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  utmTerm      String?
  utmContent   String?
  device       String   @default("desktop")
  browser      String   @default("Other")
  os           String   @default("Other")
  language     String?
  country      String?
  region       String?
  city         String?
  pageviews    Int      @default(0)
  engagedMs    Int      @default(0)
  isLead       Boolean  @default(false)

  events AnalyticsEvent[]

  @@index([startedAt])
  @@index([lastSeenAt])
  @@index([visitorId])
}

model AnalyticsEvent {
  id        BigInt           @id @default(autoincrement())
  sessionId String
  session   AnalyticsSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  type      String
  path      String
  group     String
  slug      String?
  label     String?
  area      String?
  value     Int?
  createdAt DateTime         @default(now())

  @@index([createdAt])
  @@index([type, createdAt])
  @@index([sessionId])
}

/// Daily totals kept after raw events pass the retention window.
model AnalyticsDaily {
  day       DateTime @db.Date
  metric    String
  dimension String   @default("")
  value     Int      @default(0)

  @@id([day, metric, dimension])
}
